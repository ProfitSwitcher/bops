<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.bops.local</string>
  <key>WorkingDirectory</key>
  <string>REPLACE_WITH_REPO</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_WITH_REPO/scripts/local-login.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_REPO/.data/bops-login.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_REPO/.data/bops-login.log</string>
</dict>
</plist>
